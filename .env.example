# Production Server Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=4174
DB_PATH=/data/hearthledger.db

# Multi-Tenant Auth Isolation (set true in public cloud deployment)
REQUIRE_AUTH_FOR_SYNC=true
HEARTHLEDGER_SYNC_KEY=

# Canonical URL & Google Search Console Meta Tag
APP_BASE_URL=https://your-domain.example
GOOGLE_SITE_VERIFICATION=
CORS_ALLOWED_ORIGINS=https://your-domain.example

# Razorpay (India INR / UPI / Cards)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (Global USD Cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set true only in staging/sandbox to test billing checkout without merchant keys
ALLOW_TEST_BILLING=false
